PORT=3001
NODE_ENV=development

# OpenAlex polite-pool contact (your email — gets priority routing, no key needed)
OPENALEX_EMAIL=you@example.com

# Bearer token required for POST /api/admin/sync and GET /api/admin/sync-log
ADMIN_TOKEN=change-me-to-a-long-random-string

# node-cron schedule for the automatic sync. Default: every Sunday 03:00.
# See https://www.npmjs.com/package/node-cron for the syntax.
CRON_SCHEDULE=0 3 * * 0

# Allowed CORS origins (comma-separated). Vite dev defaults to 5173.
CORS_ORIGINS=http://localhost:5173

# Path to the SQLite file (relative to backend/). Default: data/desy.db
DB_PATH=data/desy.db
